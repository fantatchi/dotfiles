#!/usr/bin/env bash
# muse-usage: best-effort usage info as JSON. Unknown values are null (see instructions sec.6-2).
set -u
python3 - <<'PY'
import json, glob, os, re
out = {"agents": {}}
# Codex: latest non-empty rate_limits in session logs
rate = None
files = sorted(glob.glob(os.path.expanduser("~/.codex/sessions/**/*.jsonl"), recursive=True), key=lambda p: os.path.getmtime(p) if os.path.exists(p) else 0)
for path in reversed(files[-20:]):
    try:
        with open(path, errors="replace") as f:
            for line in f:
                if "rate_limits" in line:
                    try:
                        obj = json.loads(line)
                    except Exception:
                        continue
                    # find rate_limits anywhere nested (shallow scan of the line's json)
                    def find(o):
                        if isinstance(o, dict):
                            if "rate_limits" in o and o["rate_limits"]:
                                return o["rate_limits"]
                            for v in o.values():
                                r = find(v)
                                if r: return r
                        elif isinstance(o, list):
                            for v in o:
                                r = find(v)
                                if r: return r
                        return None
                    r = find(obj)
                    if r: rate = r
        if rate: break
    except OSError:
        continue
out["agents"]["codex"] = {"rate_limits": rate, "source": "~/.codex/sessions/**/*.jsonl" if rate else None}
# Claude: latest rate_limit_event in muse-run stream-json logs (~/.muse/logs/*-claude.log)
crate = None; csrc = None
cfiles = sorted(glob.glob(os.path.expanduser("~/.muse/logs/*-claude.log")), key=lambda q: os.path.getmtime(q) if os.path.exists(q) else 0)
for path in reversed(cfiles):
    try:
        with open(path, errors="replace") as f:
            for line in f:
                if '"rate_limit_event"' not in line:
                    continue
                try:
                    obj = json.loads(line)
                except Exception:
                    continue
                info = obj.get("rate_limit_info") or {}
                uw = info.get("unifiedWindows") or {}
                if uw:
                    def win(w):
                        if not isinstance(w, dict): return None
                        return {"utilization": w.get("utilization"), "status": w.get("status"), "resetsAt": w.get("resetsAt")}
                    crate = {"five_hour": win(uw.get("five_hour")), "seven_day": win(uw.get("seven_day")), "rateLimitType": info.get("rateLimitType"), "overageStatus": info.get("overageStatus")}
                    csrc = path
        if crate: break
    except OSError:
        continue
out["agents"]["claude"] = {"rate_limits": crate, "source": csrc} if crate else {"rate_limits": None, "note": "no rate_limit_event found in ~/.muse/logs/*-claude.log"}
out["agents"]["agy"] = {"rate_limits": None, "note": "no non-interactive source confirmed yet"}
# run counts from runs.jsonl
runs = {}
rp = os.path.expanduser("~/.muse/runs.jsonl")
if os.path.exists(rp):
    with open(rp, errors="replace") as f:
        for line in f:
            try: o = json.loads(line)
            except Exception: continue
            a = o.get("agent"); runs[a] = runs.get(a, 0) + 1
out["runs_recorded"] = runs
print(json.dumps(out, ensure_ascii=False, indent=2))
PY
